{% extends 'admin_base.html.twig' %}

{% block page_title %}Modifier la Chambre{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="bg-white rounded-4 border shadow-sm p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h5 class="brand-font mb-0">Modification : {{ room.name }}</h5>
                        <span class="text-muted small">Mettez à jour les informations et le tarif</span>
                    </div>
                    <a href="{{ path('app_admin_rooms') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-arrow-left me-1"></i> Retour à la liste
                    </a>
                </div>

                {{ form_start(form) }}
                    <div class="row g-3">
                        <div class="col-md-8">
                            {{ form_row(form.name) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.type) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.pricePerNight) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.capacity) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.surface) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.bedType) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.status) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(form.image) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(form.amenities) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(form.description) }}
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="{{ path('app_admin_rooms') }}" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-drei-primary px-4">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Mettre à jour
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
