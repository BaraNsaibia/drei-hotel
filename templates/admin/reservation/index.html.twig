{% extends 'admin_base.html.twig' %}

{% block page_title %}Gestion des Réservations{% endblock %}

{% block body %}
    <div class="bg-white rounded-4 border shadow-sm p-4">
        <!-- Header and Status Filter Pills -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-2 border-bottom">
            <div>
                <h5 class="brand-font mb-0">Registre des Réservations</h5>
                <span class="text-muted small">Suivi des demandes de séjour et des encaissements</span>
            </div>
            
            <div class="d-flex gap-2 flex-wrap">
                <a href="{{ path('app_admin_reservations') }}" class="btn btn-sm {{ current_status is empty ? 'btn-dark' : 'btn-outline-secondary' }}">
                    Toutes
                </a>
                <a href="{{ path('app_admin_reservations', {'status': 'pending'}) }}" class="btn btn-sm {{ current_status == 'pending' ? 'btn-warning text-dark' : 'btn-outline-warning text-dark' }}">
                    En attente
                </a>
                <a href="{{ path('app_admin_reservations', {'status': 'confirmed'}) }}" class="btn btn-sm {{ current_status == 'confirmed' ? 'btn-success' : 'btn-outline-success' }}">
                    Confirmées
                </a>
                <a href="{{ path('app_admin_reservations', {'status': 'completed'}) }}" class="btn btn-sm {{ current_status == 'completed' ? 'btn-secondary' : 'btn-outline-secondary' }}">
                    Terminées
                </a>
                <a href="{{ path('app_admin_reservations', {'status': 'cancelled'}) }}" class="btn btn-sm {{ current_status == 'cancelled' ? 'btn-danger' : 'btn-outline-danger' }}">
                    Annulées
                </a>
            </div>
        </div>

        {% if reservations is empty %}
            <div class="text-center py-5">
                <i class="fa-regular fa-folder-open text-muted display-4 mb-3"></i>
                <h5 class="fw-bold">Aucune réservation ne correspond au filtre sélectionné</h5>
                <p class="text-muted small">Toutes les réservations effectuées apparaîtront ici.</p>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Référence</th>
                            <th>Date Création</th>
                            <th>Client</th>
                            <th>Chambre</th>
                            <th>Séjour</th>
                            <th>Total</th>
                            <th>Statut</th>
                            <th>Paiement</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for res in reservations %}
                            <tr>
                                <td>
                                    <a href="{{ path('app_admin_reservation_show', {'id': res.id}) }}" class="fw-bold text-primary">
                                        #{{ res.reference }}
                                    </a>
                                </td>
                                <td><small class="text-muted">{{ res.createdAt|date('d/m/Y H:i') }}</small></td>
                                <td>
                                    <div class="fw-semibold">{{ res.user.fullName }}</div>
                                    <small class="text-muted">{{ res.user.email }}</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">{{ res.room.name }}</div>
                                    <small class="text-muted">{{ res.guests }} pers.</small>
                                </td>
                                <td>
                                    <div class="small">
                                        <div><strong>Arrivée :</strong> {{ res.checkIn|date('d/m/Y') }}</div>
                                        <div><strong>Départ :</strong> {{ res.checkOut|date('d/m/Y') }}</div>
                                        <span class="text-muted">{{ res.numberOfNights }} nuit{{ res.numberOfNights > 1 ? 's' : '' }}</span>
                                    </div>
                                </td>
                                <td>
                                    <strong class="text-dark">{{ res.totalPrice|number_format(2, ',', ' ') }} €</strong>
                                </td>
                                <td>
                                    <span class="badge {{ res.statusBadgeClass }}">
                                        {{ res.statusLabel }}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge {{ res.paymentBadgeClass }}">
                                        {{ res.paymentStatusLabel }}
                                    </span>
                                </td>
                                <td>
                                    <a href="{{ path('app_admin_reservation_show', {'id': res.id}) }}" class="btn btn-drei-outline btn-sm px-2 py-1" title="Voir le détail">
                                        <i class="fa-solid fa-eye me-1"></i> Détails
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
