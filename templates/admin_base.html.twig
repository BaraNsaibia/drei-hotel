<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Administration — Drei Hotel{% endblock %}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Font Awesome Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-header">
                <a href="{{ path('app_admin_dashboard') }}" class="text-white text-decoration-none d-flex align-items-center gap-2">
                    <i class="fa-solid fa-hotel fs-4 text-warning"></i>
                    <div>
                        <div class="brand-font fw-bold" style="letter-spacing: 0.05em;">DREI HOTEL</div>
                        <div class="small opacity-75" style="font-size: 0.75rem;">ESPACE ADMINISTRATION</div>
                    </div>
                </a>
            </div>
            
            <nav class="admin-nav">
                <div class="text-uppercase px-3 mb-2 small opacity-50" style="font-size: 0.75rem; letter-spacing: 0.1em;">Menu Principal</div>
                <a href="{{ path('app_admin_dashboard') }}" class="admin-nav-item {{ app.request.attributes.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}">
                    <i class="fa-solid fa-chart-pie"></i> Tableau de bord
                </a>
                <a href="{{ path('app_admin_rooms') }}" class="admin-nav-item {{ app.request.attributes.get('_route') starts with 'app_admin_room' ? 'active' : '' }}">
                    <i class="fa-solid fa-bed"></i> Chambres
                </a>
                <a href="{{ path('app_admin_reservations') }}" class="admin-nav-item {{ app.request.attributes.get('_route') starts with 'app_admin_reservation' ? 'active' : '' }}">
                    <i class="fa-solid fa-calendar-check"></i> Réservations
                </a>
                <a href="{{ path('app_admin_users') }}" class="admin-nav-item {{ app.request.attributes.get('_route') starts with 'app_admin_user' ? 'active' : '' }}">
                    <i class="fa-solid fa-users"></i> Clients
                </a>
            </nav>
            
            <div class="admin-sidebar-footer">
                <div class="d-flex align-items-center gap-2 mb-3 px-2">
                    <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                        {{ app.user.firstName|first|upper }}
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-white small fw-bold text-truncate">{{ app.user.fullName }}</div>
                        <div class="text-white-50 small" style="font-size: 0.75rem;">Administrateur</div>
                    </div>
                </div>
                <div class="d-grid gap-2">
                    <a href="{{ path('app_home') }}" class="btn btn-outline-light btn-sm text-start">
                        <i class="fa-solid fa-globe me-2"></i> Voir le site public
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-danger btn-sm text-start">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> Déconnexion
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="admin-content">
            <!-- Top Admin Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h2 class="h4 mb-0 brand-font">{% block page_title %}Tableau de bord{% endblock %}</h2>
                    <span class="text-muted small">Panneau de gestion hôtelière — Drei Hotel</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-white text-dark border p-2 shadow-sm">
                        <i class="fa-regular fa-calendar me-1 text-primary"></i> {{ "now"|date("d/m/Y") }}
                    </span>
                    <a href="{{ path('app_admin_room_new') }}" class="btn btn-drei-primary btn-sm">
                        <i class="fa-solid fa-plus me-1"></i> Ajouter une chambre
                    </a>
                </div>
            </div>

            <!-- Flash Messages -->
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show shadow-sm" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid {{ label == 'danger' ? 'fa-triangle-exclamation' : (label == 'warning' ? 'fa-circle-exclamation' : 'fa-circle-check') }} me-2 fs-5"></i>
                            <div>{{ message }}</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <!-- Admin Body Block -->
            {% block body %}{% endblock %}
        </main>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
