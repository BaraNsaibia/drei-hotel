<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Drei Hotel — Hôtel de Charme & Confort{% endblock %}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Font Awesome Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Custom Drei Hotel CSS -->
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <!-- Top Announcement Bar -->
    <div class="py-1 text-center" style="background-color: var(--color-primary-dark); color: #e0e8ed; font-size: 0.85rem; font-weight: 500;">
        <div class="container d-flex justify-content-between align-items-center">
            <span><i class="fa-solid fa-phone me-1"></i> +33 123456789 &nbsp;|&nbsp; <i class="fa-solid fa-envelope me-1"></i> Obieda.dreae@hotmail.com</span>
            <span class="d-none d-md-inline"><i class="fa-solid fa-location-dot me-1"></i> Boulevard du Jeu de Paume, 34000 Montpellier, France</span>
            <span><i class="fa-solid fa-hand-holding-dollar me-1"></i> Paiement sécurisé sur place à l'hôtel</span>
        </div>
    </div>

    <!-- Navigation Header -->
    <nav class="navbar navbar-expand-lg drei-navbar">
        <div class="container">
            <a class="navbar-brand drei-logo" href="{{ path('app_home') }}">
                <i class="fa-solid fa-hotel"></i>
                <span>DREI HOTEL</span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_room' ? 'active' : '' }}" href="{{ path('app_rooms') }}">Chambres</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_about' ? 'active' : '' }}" href="{{ path('app_about') }}">À propos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_services' ? 'active' : '' }}" href="{{ path('app_services') }}">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_contact' ? 'active' : '' }}" href="{{ path('app_contact') }}">Contact</a>
                    </li>
                </ul>
                
                <div class="d-flex align-items-center gap-2">
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                <i class="fa-solid fa-shield-halved me-1"></i> Admin
                            </a>
                        {% endif %}
                        <div class="dropdown">
                            <button class="btn btn-drei-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-circle-user me-1"></i> {{ app.user.firstName }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li><a class="dropdown-item" href="{{ path('app_account') }}"><i class="fa-solid fa-calendar-check me-2 text-primary"></i> Mes réservations</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="fa-solid fa-right-from-bracket me-2"></i> Déconnexion</a></li>
                            </ul>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-drei-outline btn-sm">
                            <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Connexion
                        </a>
                        <a href="{{ path('app_register') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            Inscription
                        </a>
                    {% endif %}
                    <a href="{{ path('app_rooms') }}" class="btn btn-drei-primary btn-sm">
                        <i class="fa-solid fa-calendar-plus me-1"></i> Réserver
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Flash Messages Container -->
    <div class="container mt-3">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fa-solid {{ label == 'danger' ? 'fa-triangle-exclamation' : (label == 'warning' ? 'fa-circle-exclamation' : 'fa-circle-check') }} me-2 fs-5"></i>
                        <div>{{ message }}</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <!-- Main Content -->
    <main class="flex-grow-1">
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="drei-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="fa-solid fa-hotel fs-3 text-warning"></i>
                        <h4 class="brand-font text-white mb-0">DREI HOTEL</h4>
                    </div>
                    <p class="text-secondary small pe-lg-4">
                        Drei Hotel vous accueille dans un environnement chaleureux, confortable et moderne, pensé pour rendre chaque séjour agréable et mémorable.
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-white opacity-75 hover-opacity-100 fs-5"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="text-white opacity-75 hover-opacity-100 fs-5"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="text-white opacity-75 hover-opacity-100 fs-5"><i class="fa-brands fa-tripadvisor"></i></a>
                    </div>
                </div>
                
                <div class="col-lg-2 col-md-6">
                    <h5>Navigation</h5>
                    <a href="{{ path('app_home') }}" class="drei-footer-link">Accueil</a>
                    <a href="{{ path('app_rooms') }}" class="drei-footer-link">Nos Chambres</a>
                    <a href="{{ path('app_about') }}" class="drei-footer-link">À propos de nous</a>
                    <a href="{{ path('app_services') }}" class="drei-footer-link">Services & Confort</a>
                    <a href="{{ path('app_contact') }}" class="drei-footer-link">Contact & Accès</a>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <h5>Informations</h5>
                    <p class="small mb-1"><i class="fa-solid fa-clock me-2 text-warning"></i> <strong>Réception :</strong> Ouverte 24h/24, 7j/7</p>
                    <p class="small mb-1"><i class="fa-solid fa-right-to-bracket me-2 text-warning"></i> <strong>Arrivée :</strong> À partir de 14h00</p>
                    <p class="small mb-1"><i class="fa-solid fa-right-from-bracket me-2 text-warning"></i> <strong>Départ :</strong> Jusqu'à 12h00</p>
                    <div class="p-2 rounded mt-2" style="background: rgba(255,255,255,0.06); font-size: 0.8rem;">
                        <i class="fa-solid fa-hand-holding-dollar text-warning me-1"></i> <strong>Paiement sur place :</strong> Règlement à la réception le jour de votre arrivée.
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <h5>Contact & Réservation</h5>
                    <p class="small mb-2"><i class="fa-solid fa-location-dot me-2 text-warning"></i> Boulevard du Jeu de Paume, 34000 Montpellier, France</p>
                    <p class="small mb-2"><i class="fa-solid fa-phone me-2 text-warning"></i> +33 123456789</p>
                    <p class="small mb-2"><i class="fa-solid fa-envelope me-2 text-warning"></i> Obieda.dreae@hotmail.com</p>
                </div>
            </div>
            
            <div class="drei-footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="mb-0">&copy; {{ "now"|date("Y") }} Drei Hotel. Tous droits réservés. Projet Académique.</p>
                <div class="mt-2 mt-md-0">
                    <span class="badge bg-secondary-subtle text-secondary me-2">Paiement sur place</span>
                    <span class="badge bg-secondary-subtle text-secondary">Annulation gratuite</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('js/app.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
