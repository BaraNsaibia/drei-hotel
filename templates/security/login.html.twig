{% extends 'base.html.twig' %}

{% block title %}Connexion — Drei Hotel{% endblock %}

{% block body %}
    <div class="container section-padding">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="bg-white p-4 p-md-5 rounded-4 border shadow-md">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-2" style="width: 52px; height: 52px;">
                            <i class="fa-solid fa-lock fs-4"></i>
                        </div>
                        <h2 class="h3 brand-font mb-1">Connexion à votre compte</h2>
                        <p class="text-muted small">Accédez à vos réservations et vos coordonnées</p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>
                            Email ou mot de passe incorrect.
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}

                    <form method="POST" action="{{ path('app_login') }}">
                        <div class="mb-3">
                            <label for="inputEmail" class="form-label small fw-bold">Adresse Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-envelope"></i></span>
                                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="exemple@email.com">
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="inputPassword" class="form-label small fw-bold mb-0">Mot de passe</label>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-key"></i></span>
                                <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="Votre mot de passe">
                            </div>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn btn-drei-primary w-100 py-3 mb-3">
                            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Se connecter
                        </button>

                        <div class="text-center">
                            <p class="small text-muted mb-0">
                                Pas encore de compte ? <a href="{{ path('app_register') }}" class="fw-bold text-primary">Créer un compte</a>
                            </p>
                        </div>
                    </form>

                    <!-- Quick Demo Credentials helper for Jury -->
                    <div class="mt-4 p-3 rounded-3 bg-light border small text-muted">
                        <div class="fw-bold text-dark mb-1"><i class="fa-solid fa-circle-info text-primary me-1"></i> Comptes de démonstration :</div>
                        <div class="d-flex justify-content-between">
                            <span><strong>Admin :</strong> admin@drei-hotel.com</span>
                            <code>Admin123!</code>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span><strong>Client :</strong> client@drei-hotel.com</span>
                            <code>Client123!</code>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
