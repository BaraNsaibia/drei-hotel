{% extends 'base.html.twig' %}

{% block title %}Drei Hotel — Accueil & Réservation{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <section class="hero-section text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <span class="badge bg-light text-dark px-3 py-2 rounded-pill fw-semibold mb-3 shadow-sm" style="letter-spacing: 0.1em;">
                        <i class="fa-solid fa-star text-warning me-1"></i> BIENVENUE À DREI HOTEL
                    </span>
                    <h1 class="hero-title">Un séjour confortable, élégant et inoubliable</h1>
                    <p class="hero-subtitle mx-auto">
                        Découvrez un espace chaleureux et moderne au cœur de la ville, pensé pour vous offrir une expérience hôtelière haut de gamme avec paiement direct sur place.
                    </p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a href="{{ path('app_rooms') }}" class="btn btn-drei-secondary btn-lg">
                            <i class="fa-solid fa-calendar-check me-2"></i> Réserver une chambre
                        </a>
                        <a href="#chambres-vedettes" class="btn btn-outline-light btn-lg">
                            <i class="fa-solid fa-door-open me-2"></i> Découvrir nos chambres
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Availability Search Bar -->
    <div class="container search-card-container">
        <div class="search-card">
            <form action="{{ path('app_rooms') }}" method="GET" class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-bold small text-muted mb-1"><i class="fa-regular fa-calendar-days text-primary me-1"></i> Date d'arrivée</label>
                    <input type="date" name="check_in" class="form-control form-control-lg fs-6" min="{{ "now"|date("Y-m-d") }}" value="{{ "now"|date("Y-m-d") }}">
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-bold small text-muted mb-1"><i class="fa-regular fa-calendar-check text-primary me-1"></i> Date de départ</label>
                    <input type="date" name="check_out" class="form-control form-control-lg fs-6" min="{{ "+1 day"|date("Y-m-d") }}" value="{{ "+1 day"|date("Y-m-d") }}">
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-bold small text-muted mb-1"><i class="fa-solid fa-user-group text-primary me-1"></i> Personnes</label>
                    <select name="capacity" class="form-select form-select-lg fs-6">
                        <option value="">Tous</option>
                        <option value="1">1 Personne</option>
                        <option value="2" selected>2 Personnes</option>
                        <option value="3">3 Personnes</option>
                        <option value="4">4+ Personnes</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-bold small text-muted mb-1"><i class="fa-solid fa-bed text-primary me-1"></i> Type</label>
                    <select name="type" class="form-select form-select-lg fs-6">
                        <option value="">Toutes catégories</option>
                        <option value="standard">Standard</option>
                        <option value="deluxe">Deluxe</option>
                        <option value="suite">Suite Drei</option>
                        <option value="family">Familiale</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-12 d-grid">
                    <button type="submit" class="btn btn-drei-primary btn-lg fs-6">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Vérifier
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Featured Rooms Section -->
    <section id="chambres-vedettes" class="section-padding">
        <div class="container">
            <div class="section-header">
                <span class="section-subtitle">Nos Espaces de Repos</span>
                <h2 class="section-title">Chambres & Suites d'Exception</h2>
                <p class="text-muted">
                    Chaque chambre du Drei Hotel a été conçue pour allier esthétique raffinée, literie haut de gamme et confort absolu.
                </p>
            </div>

            <div class="row g-4">
                {% for room in featured_rooms %}
                    <div class="col-lg-4 col-md-6">
                        <div class="drei-card h-100 d-flex flex-direction-column">
                            <div class="room-card-img-wrap">
                                {% if room.type == 'standard' %}
                                    <img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80" alt="{{ room.name }}" class="room-card-img">
                                {% elseif room.type == 'deluxe' %}
                                    <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80" alt="{{ room.name }}" class="room-card-img">
                                {% elseif room.type == 'suite' %}
                                    <img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=800&q=80" alt="{{ room.name }}" class="room-card-img">
                                {% else %}
                                    <img src="https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=800&q=80" alt="{{ room.name }}" class="room-card-img">
                                {% endif %}
                                <div class="room-capacity-badge">
                                    <i class="fa-solid fa-users me-1"></i> {{ room.capacity }} personne{{ room.capacity > 1 ? 's' : '' }}
                                </div>
                                <div class="room-price-badge">
                                    {{ room.pricePerNight|number_format(0, ',', ' ') }} € <span class="fw-normal small">/ nuit</span>
                                </div>
                            </div>
                            
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary-subtle text-secondary small">{{ room.typeName }}</span>
                                    {% if room.surface %}
                                        <span class="text-muted small"><i class="fa-solid fa-vector-square me-1"></i> {{ room.surface }} m²</span>
                                    {% endif %}
                                </div>
                                <h3 class="h5 mb-2">{{ room.name }}</h3>
                                <p class="text-muted small mb-3 flex-grow-1">
                                    {{ room.description|length > 110 ? room.description|slice(0, 110) ~ '...' : room.description }}
                                </p>
                                
                                <div class="mb-3">
                                    {% for amenity in room.amenities|slice(0, 3) %}
                                        <span class="amenity-tag"><i class="fa-solid fa-check text-success"></i> {{ amenity }}</span>
                                    {% endfor %}
                                </div>
                                
                                <div class="d-flex gap-2 pt-2 border-top">
                                    <a href="{{ path('app_room_show', {'id': room.id}) }}" class="btn btn-drei-outline btn-sm flex-grow-1">
                                        Voir la chambre
                                    </a>
                                    <a href="{{ path('app_reservation_new', {'id': room.id}) }}" class="btn btn-drei-primary btn-sm px-3">
                                        Réserver
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-4">
                        <p class="text-muted">Aucune chambre disponible pour le moment.</p>
                    </div>
                {% endfor %}
            </div>

            <div class="text-center mt-5">
                <a href="{{ path('app_rooms') }}" class="btn btn-drei-secondary btn-lg px-4">
                    <i class="fa-solid fa-list me-2"></i> Consulter toutes nos chambres
                </a>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="section-padding" style="background-color: #F0ECE4;">
        <div class="container">
            <div class="section-header">
                <span class="section-subtitle">Pour un Séjour Idéal</span>
                <h2 class="section-title">Les Services Drei Hotel</h2>
                <p class="text-muted">
                    Profitez d'un éventail complet de prestations conçues pour votre confort, votre sérénité et votre bien-être.
                </p>
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="service-box">
                        <div class="service-icon-circle"><i class="fa-solid fa-wifi"></i></div>
                        <h4 class="h5 mb-2">Wi-Fi Haut Débit Gratuit</h4>
                        <p class="text-muted small mb-0">Connexion fibre ultra-rapide et illimitée dans toutes les chambres et les espaces communs.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="service-box">
                        <div class="service-icon-circle"><i class="fa-solid fa-mug-saucer"></i></div>
                        <h4 class="h5 mb-2">Petit-Déjeuner Gourmand</h4>
                        <p class="text-muted small mb-0">Buffet continental complet avec viennoiseries fraîches, fruits de saison et spécialités locales.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="service-box">
                        <div class="service-icon-circle"><i class="fa-solid fa-square-parking"></i></div>
                        <h4 class="h5 mb-2">Parking Sécurisé</h4>
                        <p class="text-muted small mb-0">Emplacements de stationnement privés et surveillés 24h/24 gratuitement réservés à nos hôtes.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="service-box">
                        <div class="service-icon-circle"><i class="fa-solid fa-bell-concierge"></i></div>
                        <h4 class="h5 mb-2">Réception 24h/24 & 7j/7</h4>
                        <p class="text-muted small mb-0">Notre équipe dédiée est à votre entière disposition à tout moment pour répondre à vos demandes.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="service-box">
                        <div class="service-icon-circle"><i class="fa-solid fa-snowflake"></i></div>
                        <h4 class="h5 mb-2">Climatisation & Confort</h4>
                        <p class="text-muted small mb-0">Chauffage et climatisation individuelle réglable dans chaque pièce pour une atmosphère sur-mesure.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="service-box">
                        <div class="service-icon-circle"><i class="fa-solid fa-utensils"></i></div>
                        <h4 class="h5 mb-2">Service en Chambre</h4>
                        <p class="text-muted small mb-0">Savourez une sélection de plats et rafraîchissements servis directement dans votre chambre.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Drei Hotel Section -->
    <section class="section-padding">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80" alt="Drei Hotel Lobby" class="img-fluid rounded-4 shadow-lg">
                        <div class="position-absolute bottom-0 start-0 translate-middle-y bg-white p-3 rounded-3 shadow-md ms-4 d-none d-sm-block border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-warning text-dark p-2 rounded-2"><i class="fa-solid fa-award fs-4"></i></div>
                                <div>
                                    <div class="fw-bold">Excellence Hôtelière</div>
                                    <div class="small text-muted">Satisfaction client garantie</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <span class="section-subtitle">Notre Philosophie</span>
                    <h2 class="section-title mb-3">Drei Hotel vous accueille avec élégance et chaleur</h2>
                    <p class="text-muted mb-4">
                        Drei Hotel vous accueille dans un environnement chaleureux, confortable et moderne, pensé pour rendre chaque séjour agréable et reposant. Que vous voyagiez pour affaires, en couple ou en famille, notre établissement vous garantit un service attentionné et personnalisé.
                    </p>
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-circle-check text-primary fs-5"></i>
                                <span class="fw-semibold">Emplacement de choix</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-circle-check text-primary fs-5"></i>
                                <span class="fw-semibold">Paiement direct sur place</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-circle-check text-primary fs-5"></i>
                                <span class="fw-semibold">Hygiène & Propreté 5 étoiles</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-circle-check text-primary fs-5"></i>
                                <span class="fw-semibold">Literie haute qualité</span>
                            </div>
                        </div>
                    </div>
                    <a href="{{ path('app_about') }}" class="btn btn-drei-primary">
                        En savoir plus sur notre hôtel <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>



    <!-- Payment On Site Callout & Contact Banner -->
    <section class="section-padding">
        <div class="container">
            <div class="p-5 rounded-4 shadow-sm text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold mb-3">
                            <i class="fa-solid fa-shield-halved me-1"></i> RÉSERVATION SANS CARTE EN LIGNE
                        </span>
                        <h2 class="text-white brand-font mb-3">Paiement en toute sérénité sur place à l'hôtel</h2>
                        <p class="text-light opacity-90 mb-0">
                            Réservez votre séjour en quelques secondes. Aucun numéro de carte bancaire n'est requis en ligne. Vous réglez directement à la réception lors de votre arrivée.
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="{{ path('app_rooms') }}" class="btn btn-drei-secondary btn-lg px-4 py-3">
                            <i class="fa-solid fa-calendar-check me-2"></i> Réserver maintenant
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
